// Prisma schema — persistence scaffolding for future versioned content / admin workflow.
// Public pages still read from `src/content` until a later phase wires publish/read paths.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ImportStatus {
  UPLOADED
  PARSED
  NEEDS_REVIEW
  MERGED
  REJECTED
  FAILED
}

enum UploadSourceFormat {
  DOCX
  PDF
}

enum ContentEventType {
  IMPORT_CREATED
  PARSE_COMPLETED
  VERSION_CREATED
  VERSION_PUBLISHED
  VERSION_ARCHIVED
  UPLOAD_STORED
  SYSTEM_NOTE
  WORKING_DRAFT_CREATED
  WORKING_DRAFT_UPDATED
  CONTENT_PUBLISHED
  CONTENT_RESTORED_TO_DRAFT
  CV_BASELINE_ACCEPTED
  CV_FIELD_LOCKED
  CV_SECTION_MAPPED
  CV_CHANGE_SET_GENERATED
}

/// Generic presentation for previously unknown CV sections accepted into a draft.
enum CvDynamicSectionPresentation {
  RICH_TEXT
  BULLET_LIST
  TIMELINE
  GROUPED_CARDS
  KEY_VALUE
  KEEP_IN_CV
  IGNORE
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

/// Secondary admin device registrations (browser gate). Prefer Postgres when `DATABASE_URL` is set to avoid GitHub JSON write races.
model AdminRegisteredDevice {
  id           String   @id
  label        String
  userAgent    String
  ipHash       String
  registeredAt DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@index([ipHash])
}

model UploadedFile {
  id           String             @id @default(cuid())
  originalName String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  sha256       String
  sourceFormat UploadSourceFormat
  uploadedAt   DateTime           @default(now())
  imports      ContentImport[]
}

model ContentImport {
  id                String               @id @default(cuid())
  uploadedFileId    String
  uploadedFile      UploadedFile         @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  status            ImportStatus         @default(UPLOADED)
  parserVersion     String?
  warnings          Json?
  rawPreviewPath    String?
  /// Structured parser output before normalization (optional; not live site content).
  rawExtract        Json?
  /// Parsed candidate payload for review — never the published/draft SiteContent until merged in a later phase.
  candidatePayload  Json?
  /// Candidate-vs-baseline reconciliation manifest (`CandidateReviewManifest` envelope).
  reviewManifest    Json?
  /// Explicit admin approvals for reconciliation decisions.
  reviewApprovals   Json?
  /// Persisted three-way CV change set (accepted CV baseline × candidate × website).
  changeSet         Json?
  /// Professor/admin decisions on change-set items (bulk-saved; revision-checked).
  changeDecisions   Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  versions          ContentVersion[]
  acceptedBaselines AcceptedCvBaseline[]
}

model ContentVersion {
  id              String               @id @default(cuid())
  importId        String?
  contentImport   ContentImport?       @relation(fields: [importId], references: [id], onDelete: SetNull)
  status          ContentVersionStatus @default(DRAFT)
  label           String?
  /// Snapshot of canonical site content (or partial) as JSON until normalized tables exist.
  payload         Json
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  publishedAt     DateTime?
  /// Human note for this revision (admin UI later).
  changeSummary   String?
  /// Future: admin user id or email when auth is wired.
  createdBy       String?
  /// Exactly one working draft: `draftSlot = "main"`. Null for published/archived rows.
  draftSlot       String?              @unique
  /// Monotonic publish ordering for published rows only.
  publishSequence Int?
  events          ContentEvent[]

  @@index([status])
  @@index([importId])
  @@index([publishSequence])
}

model ContentEvent {
  id        String           @id @default(cuid())
  versionId String?
  version   ContentVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  eventType ContentEventType
  payload   Json?
  createdAt DateTime         @default(now())

  @@index([versionId])
  @@index([eventType])
}

/// Non-secret professor-selected AI runtime (on/off, provider, model). Secrets stay in env only.
model AiRuntimeSetting {
  id        String   @id
  enabled   Boolean
  provider  String
  model     String?
  revision  Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Last successfully accepted/imported CV normalized source.
 * Singleton via `slot = "current"` — used as the previous-CV baseline for change detection.
 * Never written during upload alone; updated when an import is successfully merged to draft
 * (or explicitly accepted). Does not alter published SiteContent.
 */
model AcceptedCvBaseline {
  id                 String        @id @default(cuid())
  /// Exactly one current baseline: `slot = "current"`.
  slot               String        @unique @default("current")
  sourceImportId     String
  sourceImport       ContentImport @relation(fields: [sourceImportId], references: [id], onDelete: Restrict)
  acceptedAt         DateTime      @default(now())
  parserVersion      String
  mappingVersion     String
  sourceTextHash     String?
  /// Normalized scalars, list items, fingerprints, and source section mappings.
  normalizedSnapshot Json
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([sourceImportId])
  @@index([acceptedAt])
}

/**
 * Persistent “keep website value for future CV imports” locks.
 * Suppresses repeated review of the same parser downgrade until the CV source fingerprint changes.
 */
model ImportFieldLock {
  id                        String   @id @default(cuid())
  /// Dot path e.g. `profile.displayName`, `profile.homeAboutIntro`.
  fieldPath                 String   @unique
  lockedWebsiteFingerprint  String
  /// JSON snapshot of the locked website value (scalar or small object).
  lockedWebsiteValue        Json
  /// Fingerprint of the CV candidate value that was rejected when locking.
  rejectedSourceFingerprint String?
  reason                    String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

/**
 * Remembered mapping from an unknown CV heading → generic presentation (or ignore/keep-in-CV).
 * Applied on future uploads without requiring a code deploy.
 */
model CvSectionMapping {
  id              String                       @id @default(cuid())
  normalizedTitle String                       @unique
  sourceTitle     String
  presentation    CvDynamicSectionPresentation
  displayTitle    String?
  sortOrder       Int                          @default(100)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}
